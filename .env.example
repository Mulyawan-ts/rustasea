# Copy to `.env` and adjust per environment. Loaded via dotenvy (rustasea-config).
# Environment variables always win over `config/*.toml` (the loader applies the
# process environment last; nested keys use the `__` separator, e.g.
# `SERVICES__POSTMARK__KEY`). Single-underscore vars below are read directly by
# the typed config consumers (AppConfig, MailConfig, ServicesConfig, …).

# ---------------------------------------------------------------------------
# Application (config/app.toml)
# ---------------------------------------------------------------------------
APP_NAME=RustaSea
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generate with `cargo artisan key:generate`; empty means "unset".
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# ---------------------------------------------------------------------------
# Logging (config/logging.toml)
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
# Members of the `stack` channel (comma-separated).
LOG_STACK=daily,stderr
# Retention (days) of the `daily` channel.
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------------
# Mail (config/mail.toml)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=RustaSea

# ---------------------------------------------------------------------------
# Cache (config/cache.toml)
# ---------------------------------------------------------------------------
# MUST contain the hyphenated `-cache-` marker.
CACHE_PREFIX=rustasea-cache-

# ---------------------------------------------------------------------------
# Queue (config/queue.toml)
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Session (config/session.toml)
# ---------------------------------------------------------------------------
# Only the `memory` driver is implemented today.
SESSION_DRIVER=memory
SESSION_LIFETIME=120
SESSION_COOKIE=rustasea-session
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Database (config/database.toml)
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_URL=sqlite://database.sqlite?mode=rwc
# Full override honoured by rustasea-orm at runtime (wins over the fields above).
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rustasea
DB_USERNAME=rustasea
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Redis (config/database.toml + config/cache.toml)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------------------
# MongoDB (config/mongo.toml + config/database.toml)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=rustasea

# ---------------------------------------------------------------------------
# Third-party services (config/services.toml + config/storage.toml)
# NEVER commit real secrets.
# ---------------------------------------------------------------------------
POSTMARK_API_KEY=
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

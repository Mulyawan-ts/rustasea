/target

# Runtime storage (README scaffold): storage/app + storage/logs are runtime
# artifacts; keep the dirs via .gitkeep.
/storage/app/*
/storage/logs/*
!/storage/app/.gitkeep
!/storage/logs/.gitkeep

# Local environment overrides — commit only .env.example.
/.env

# Local SQLite artifacts (test/runtime databases) — never commit.
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
